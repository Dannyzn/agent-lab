# External source checkouts
upstream/*
!upstream/.gitkeep

# Workspace-local build toolchain and downloads
.tools/
work/

# Experiment output
experiments/**/target/
experiments/**/.venv/
experiments/**/node_modules/
experiments/**/artifacts/

# Rust build output
target/

# Secrets and local configuration
.env
.env.*
!.env.example

# OS/editor files
.DS_Store
.idea/
.vscode/

# Python interpreter cache
__pycache__/
*.py[cod]

# Private provider profiles, launchers and live-provider experiments
/configs/providers/
/experiments/*-live/
/scripts/run-provider.py

# Private durable conversations and source-bearing rollout logs
/sessions/
*.session.jsonl
*.rollout.jsonl
